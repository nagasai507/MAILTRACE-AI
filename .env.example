# Backend production configuration
FLASK_ENV=production
DOMAIN=mailtrace.example.com
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=mysql+pymysql://mailtrace:replace-password@db:3306/mailtrace
CORS_ORIGINS=https://mailtrace.example.com
FORCE_HTTPS=true

# Required for the first admin seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-12-character-password

# Keep disabled unless outbound enrichment is approved
ENABLE_EXTERNAL_INTEL=false
IP_GEO_API_URL=https://ipwho.is/{ip}

# Frontend build configuration
VITE_API_URL=/api
